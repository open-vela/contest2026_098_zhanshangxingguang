#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config EXAMPLES_MIC
	tristate "BK7258 mic self-test command"
	default n
	---help---
		Audio ADC self-test: mic test [N] captures 16 kHz mono
		PCM for N seconds and prints RMS / peak / raw samples.

if EXAMPLES_MIC

config EXAMPLES_MIC_PROGNAME
	string "Program name"
	default "mic"
	---help---
		NSH command name.

config EXAMPLES_MIC_PRIORITY
	int "Task priority"
	default 100

config EXAMPLES_MIC_STACKSIZE
	int "Stack size"
	default DEFAULT_TASK_STACKSIZE

endif
