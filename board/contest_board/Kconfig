config LCD_GC9D01
	bool "GC9D01 160x160 RGB565 LCD (bit-bang SPI)"
	default n
	---help---
		Enable the GC9D01 160x160 round LCD on the BK7258 DevKit.
		Uses bit-bang SPI on QSPI1 pins (GPIO 2-5) with separate
		DC pin.  Fills screen with red on boot as a smoke test.


config LCD_GC9D01_HW_SPI
	bool "Use hardware SPI1 for GC9D01 left-screen data"
	default n
	depends on LCD_GC9D01
	---help---
		Use BK7258 SPI1 peripheral (GPIO 2/3/4) for left-screen
		data transfers instead of bit-bang SPI.  Right screen stays
		bit-bang (pins don't map to a single SPI peripheral).
		All SPI polling loops have timeout protection.
		Enable only after verifying SPI1 works on your board.

config LCD_GC9D01_SPI_CLK_DIV
	int "SPI1 clock divider (clk_rate field)"
	default 1
	depends on LCD_GC9D01_HW_SPI
	---help---
		SPI1 clock = XTAL (26 MHz) / (clk_div + 1).
		clk_div=0  -> 26 MHz
		clk_div=1  -> 13 MHz (default)
		clk_div=3  -> 6.5 MHz
		clk_div=12 -> 2 MHz
		Range: 0-255 (8-bit field).

config LCD_GC9D01_SPI_BURST
	int "SPI1 FIFO burst write count"
	default 32
	depends on LCD_GC9D01_HW_SPI
	---help---
		Burst write count for SPI FIFO.  Accepted values: 1, 16, 32.
		1  = per-byte tx_fifo_wr_ready polling (safe, slow)
		16 = tx_fifo_int level 1, write 16 bytes per poll
		32 = tx_fifo_int level 2, write 32 bytes per poll (default)

config LCD_GC9D01_SPI_BYTE_INTERVAL
	int "SPI1 byte interval (idle clocks between bytes)"
	default 0
	range 0 63
	depends on LCD_GC9D01_HW_SPI
	---help---
		CTRL register bit[24:29].  Number of idle SCLK cycles
		inserted between consecutive bytes.  0 is safe for GC9D01.

config LCD_GC9D01_TILE_BYTES
	int "HW SPI tile buffer size for lcd_fill_rect"
	default 1024
	depends on LCD_GC9D01_HW_SPI
	---help---
		lcd_fill_rect() uses a pre-filled tile buffer to batch pixel
		data into fewer SPI transfers.  Range: 48-4095.

config LCD_GC9D01_HWSPI_MIN_LEN
	int "Minimum data length to use hardware SPI"
	default 8
	depends on LCD_GC9D01_HW_SPI
	---help---
		BK7258 SPI does not assert tx_finish_int when tx_trans_len==1.
		Transfers shorter than this threshold use bit-bang instead.

config LCD_GC9D01_SPI_VERIFY
	bool "Verify SPI byte count in lcd_spi_write"
	default n
	depends on LCD_GC9D01_HW_SPI
	---help---
		Count bytes actually written to the SPI DATA register during
		each lcd_spi_write() call and compare with the requested len.
		Enable only for debugging.

menu "GC2145 Camera Configuration"

comment "Board-level facts from schematic — DO NOT change without schematic revision"

config CAMERA_GPIO_SDA
	int "SCCB SDA GPIO Pin"
	default 43
	---help---
		AIDK schematic: SDA=P43 (IIC2_SDA), R36 10K pull-up.
		DO NOT swap with SCL.

config CAMERA_GPIO_SCL
	int "SCCB SCL GPIO Pin"
	default 42
	---help---
		AIDK schematic: SCL=P42 (IIC2_SCL), R38 10K pull-up.
		DO NOT swap with SDA.

config CAMERA_GPIO_RST
	int "Camera RST GPIO Pin"
	default 28
	---help---
		AIDK schematic: DVP_RST=P28, R39 10K pull-up, active-low.

config CAMERA_GPIO_PWR_CTL
	int "Camera Power Control GPIO Pin"
	default 49
	---help---
		AIDK schematic: DVP_PWR_CTL=P49, R31 100K pull-down (default off).
		Active-high enables Camera LDO 2.8V (U4) and DVDD 1.8V (U5).

config CAMERA_GPIO_PWDNB
	int "Camera PWDNB GPIO Pin"
	default -1
	---help---
		AIDK schematic: PWDNB NOT connected to MCU (R40 10K bias, R41 NC).
		Hardwired, not MCU-controlled. Leave as -1 (unconfigured).

config CAMERA_MCLK_GPIO
	int "Camera MCLK GPIO Pin"
	default 27
	---help---
		AIDK schematic: DVP_MCLK=P27. Code hard-codes P27 for MCLK.

comment "SCCB confirmation — check only after verifying with logic analyzer"

config CAMERA_SCCB_CONFIRMED
	bool "I2C bus has been verified with logic analyzer"
	default n
	---help---
		MUST be verified before first camera power-on.
		Verify: SDA waveform, SCL frequency, ACK from 0x3C.

config CAMERA_SDA_SCL_ROLE_CONFIRMED
	bool "SDA/SCL pin assignment verified (not swapped)"
	default n
	---help---
		Verify with scope: SCL=P42 always output, SDA=P43 changes direction.

config CAMERA_RST_GPIO_CONFIRMED
	bool "RST pin confirmed on correct GPIO"
	default n

config CAMERA_RST_POLARITY_CONFIRMED
	bool "RST active level verified against schematic"
	default n
	---help---
		Schematic: R39 10K pull-up → RST is active-low.

config CAMERA_RST_ACTIVE_LOW
	bool "RST is active-low (pull-up default)"
	default y
	depends on CAMERA_RST_POLARITY_CONFIRMED
	---help---
		y = drive LOW to assert reset, release(HIGH) to deassert.
		Schematic: R39 10K pull-up → active-low.

config CAMERA_PWR_CONFIRMED
	bool "PWR net identified in schematic"
	default n

config CAMERA_PWR_POLARITY_CONFIRMED
	bool "PWR active level verified against schematic"
	default n
	---help---
		Schematic: R31 100K pull-down → PWR is active-high.

config CAMERA_PWR_ACTIVE_HIGH
	bool "PWR_CTL is active-high (pull-down default)"
	default y
	depends on CAMERA_PWR_POLARITY_CONFIRMED
	---help---
		y = drive HIGH to power on camera LDO.
		Schematic: R31 100K pull-down → active-high.

comment "MCLK — check only after verifying MCLK output on P27"

config CAMERA_MCLK_CONFIRMED
	bool "MCLK output verified on P27"
	default n
	---help---
		Single safety gate for MCLK: when n, mclk_enable_24mhz()
		is never called. No separate MCLK_INIT needed.

comment "DVP signal polarity — adjust if camera sync fails"

config DVP_PCLK_FALLING
	bool "Sample DVP data on PCLK falling edge"
	default n
	---help---
		Default: sample on PCLK rising edge.  Set y if the camera
		outputs data on the falling edge of PCLK.  Check with
		oscilloscope if 'camera sync' fails.

config DVP_HSYNC_ACTIVE_LOW
	bool "HSYNC is active-low"
	default n
	---help---
		Default: HSYNC is active-high.  Set y if the camera's HSYNC
		signal is inverted (active-low during valid line).

config DVP_VSYNC_ACTIVE_LOW
	bool "VSYNC is active-low"
	default n
	---help---
		Default: VSYNC is active-high.  Set y if the camera's VSYNC
		signal is inverted (active-low during valid frame).


choice
	prompt "DVP capture resolution"
	default DVP_CAPTURE_640X480
	---help---
		Select the sensor output resolution.

config DVP_CAPTURE_640X480
	bool "640x480 (VGA, default)"

config DVP_CAPTURE_480X320
	bool "480x320 (half VGA, less bandwidth)"

endchoice

config DVP_CAPTURE_HRES
	int
	default 640 if DVP_CAPTURE_640X480
	default 480 if DVP_CAPTURE_480X320

config DVP_CAPTURE_VRES
	int
	default 480 if DVP_CAPTURE_640X480
	default 320 if DVP_CAPTURE_480X320

endmenu # GC2145 Camera Configuration

endmenu # Board Contest Board Configuration
